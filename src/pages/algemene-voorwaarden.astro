---
// src/pages/algemene-voorwaarden.astro — (Fase 3) — PAGE_SPECS §JURIDISCH
// Indexeerbaar. Definitieve voorwaarden zijn nog niet door eigenaar aangeleverd
// (TE_VERIFIËREN). Geen bindende juridische tekst verzinnen — verwijs naar de
// schriftelijke offerte en de NOA-voorwaarden, en bied opvraagbaarheid aan.
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/sections/HeroSection.astro';
import ContentBlok from '@components/sections/ContentBlok.astro';
import { bedrijf } from '@data/bedrijf';

const body = `
  <p>Op al onze werkzaamheden en offertes zijn algemene voorwaarden van toepassing.
  Wij maken graag heldere afspraken vooraf, zodat u precies weet waar u aan toe bent.</p>

  <h2>Heldere afspraken vooraf</h2>
  <ul>
    <li>Wij werken altijd met een schriftelijke offerte vooraf</li>
    <li>Geen meerwerk zonder uw akkoord</li>
    <li>Een vaste prijs, tenzij de situatie wezenlijk anders is dan afgesproken</li>
  </ul>
  <p>De voorwaarden die op uw opdracht van toepassing zijn, vindt u terug in de
  offerte die u van ons ontvangt.</p>

  <h2>NOA-voorwaarden</h2>
  <p>${bedrijf.naam} is een NOA-erkend stukadoorsbedrijf. Op onze werkzaamheden zijn
  de voorwaarden van de NOA (Nederlandse Ondernemersvereniging voor
  Afbouwbedrijven) van toepassing. Lees meer over wat dit keurmerk betekent op onze
  pagina over <a href="/certificeringen-en-keurmerken">keurmerken en certificeringen</a>.</p>

  <h2>Voorwaarden opvragen</h2>
  <p>Wilt u onze volledige algemene voorwaarden vooraf inzien? Vraag ze gerust bij ons
  op. Bel <a href="tel:${bedrijf.telefoon}">${bedrijf.telefoonDisplay}</a> of neem
  contact op via onze <a href="/contact">contactpagina</a> en wij sturen ze u toe.</p>
`;
---

<BaseLayout
  title="Algemene voorwaarden | Van Bijsteren Stukadoorsbedrijf"
  description="De algemene voorwaarden van Van Bijsteren Stukadoorsbedrijf. Heldere afspraken vooraf en NOA-erkend vakmanschap."
>
  <HeroSection
    variant="simple"
    heading="Algemene voorwaarden"
    subheading="Heldere afspraken vooraf, vastgelegd in een schriftelijke offerte."
    primaryCta={{ label: 'Neem contact op', href: '/contact' }}
  />

  <ContentBlok body={body} />
</BaseLayout>
