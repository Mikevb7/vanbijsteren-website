---
// src/pages/werken-bij/open-sollicitatie.astro — (Fase 3, redesign v2) — PAGE_SPECS §recruitment
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import BreadcrumbSchema from '@components/schema/BreadcrumbSchema.astro';
import HeroSection from '@components/sections/HeroSection.astro';
import FormComponent from '@components/ui/FormComponent.astro';
import Icon from '@components/ui/Icon.astro';
import { Phone, Mail, Clock } from 'lucide-astro';
import { bedrijf } from '@data/bedrijf';

const kruimels = [
  { label: 'Home', href: '/' },
  { label: 'Werken bij', href: '/werken-bij' },
  { label: 'Open sollicitatie' },
];

const trust = [
  { icon: 'Clock', titel: 'Reactie binnen 2 werkdagen', tekst: 'Altijd een persoonlijk antwoord — geen radiostilte.' },
  { icon: 'Users', titel: 'Persoonlijk contact', tekst: 'Je spreekt direct met de eigenaar of teamleider.' },
  { icon: 'Award', titel: 'Ook zonder ervaring', tekst: 'Motivatie weegt zwaarder dan wat je al kunt.' },
];
---

<BaseLayout
  title="Open sollicitatie stukadoor | Van Bijsteren Harderwijk"
  description="Geen geschikte vacature gevonden? Stuur een open sollicitatie. Van Bijsteren is altijd geïnteresseerd in goede stukadoors."
>
  <BreadcrumbSchema items={kruimels.map((k) => ({ naam: k.label, href: k.href }))} />

  <div class="container pt-6"><Breadcrumbs items={kruimels} /></div>

  <HeroSection
    variant="simple"
    badge="Altijd welkom"
    heading="Open sollicitatie"
    subheading="Staat er geen passende vacature open, maar denk je dat je bij ons past? Stuur ons gerust een open sollicitatie. Wij kijken liever naar wie je bent dan naar wat je al kunt."
    primaryCta={{ label: `Bel ${bedrijf.telefoonDisplay}`, href: `tel:${bedrijf.telefoon}`, ariaLabel: `Bel ${bedrijf.telefoonDisplay} — ${bedrijf.naam}` }}
  />

  <section class="container py-10 sm:py-16 lg:py-24">
    <div class="grid gap-6 sm:gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-14">
      <!-- Formulier -->
      <div class="rounded-2xl border border-border-light bg-surface p-5 shadow-sm sm:p-7 lg:p-10">
        <span class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-primary-dark">
          <span class="h-px w-8 bg-primary-dark"></span>
          Solliciteer
        </span>
        <h2 class="mt-3 text-ink tracking-tight">Stuur je sollicitatie</h2>
        <p class="mt-2 text-ink-light">Laat wat over jezelf horen — cv is optioneel.</p>
        <div class="mt-8">
          <FormComponent variant="sollicitatie" />
        </div>
      </div>

      <!-- Trust + alternatieven -->
      <aside class="flex flex-col gap-6">
        <div class="rounded-2xl bg-primary-10 p-7 ring-1 ring-primary/15 lg:p-8">
          <h3 class="text-xl font-semibold text-ink tracking-tight">Wat je van ons kunt verwachten</h3>
          <ul class="mt-5 flex flex-col gap-5">
            {trust.map((t) => (
              <li class="flex items-start gap-4">
                <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-primary-dark shadow-sm ring-1 ring-primary/15">
                  <Icon name={t.icon} size={22} />
                </span>
                <div>
                  <p class="font-semibold text-ink">{t.titel}</p>
                  <p class="mt-1 text-sm leading-relaxed text-ink-light">{t.tekst}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-border-light bg-surface p-7 lg:p-8">
          <h3 class="text-xl font-semibold text-ink tracking-tight">Liever direct contact?</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-light">Prima. Bel of mail — je krijgt altijd een persoon aan de lijn.</p>
          <div class="mt-5 flex flex-col gap-3">
            <a
              href={`tel:${bedrijf.telefoon}`}
              class="group inline-flex items-center gap-3 rounded-xl border border-border-light bg-surface-soft px-4 py-3 transition-colors hover:bg-primary-10 hover:border-primary/25"
            >
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-white">
                <Phone size={18} aria-hidden="true" />
              </span>
              <span>
                <span class="block text-xs font-semibold uppercase tracking-wide text-ink-muted">Bellen</span>
                <span class="block font-semibold text-ink">{bedrijf.telefoonDisplay}</span>
              </span>
            </a>
            <a
              href={`mailto:${bedrijf.email}`}
              class="group inline-flex items-center gap-3 rounded-xl border border-border-light bg-surface-soft px-4 py-3 transition-colors hover:bg-primary-10 hover:border-primary/25"
            >
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-white">
                <Mail size={18} aria-hidden="true" />
              </span>
              <span>
                <span class="block text-xs font-semibold uppercase tracking-wide text-ink-muted">Mailen</span>
                <span class="block font-semibold text-ink break-all">{bedrijf.email}</span>
              </span>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
