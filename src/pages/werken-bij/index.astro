---
// src/pages/werken-bij/index.astro — employer branding hub (Fase 3, redesign v2) — PAGE_SPECS §recruitment
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/sections/HeroSection.astro';
import Icon from '@components/ui/Icon.astro';
import WerkwijzeSection from '@components/sections/WerkwijzeSection.astro';
import CTASection from '@components/sections/CTASection.astro';
import { ArrowRight, Sparkles } from 'lucide-astro';
import { bedrijf } from '@data/bedrijf';
import stukadoorAanHetWerk from '@assets/images/werkfoto/stukadoor-aan-het-werk.jpg';
import stucwerkInUitvoering from '@assets/images/werkfoto/stucwerk-in-uitvoering.jpg';

const vacatures = (await getCollection('vacatures', (v) => v.data.isActief))
  .sort((a, b) => a.data.titel.localeCompare(b.data.titel));

const redenen = [
  { icon: 'Users', titel: 'Je bent geen nummer', body: 'Bij Van Bijsteren werk je in een klein, hecht team. Korte lijnen, directe communicatie en een werkgever die je bij naam kent. Geen grote organisatie met nummers en formulieren.' },
  { icon: 'Award', titel: 'Mooi en afwisselend werk', body: 'De ene dag werk je aan strak gladpleisterwerk in een nieuwbouwhuis, de andere dag breng je Frescolori aan in een luxe renovatieproject. Werk om trots op te zijn.' },
  { icon: 'MapPin', titel: 'Noord-Veluwe — geen uren reizen', body: 'Wij werken in Harderwijk en directe omgeving. Geen vroege files richting de Randstad. ’s Avonds gewoon thuis.' },
  { icon: 'Shield', titel: 'Vast contract en nette voorwaarden', body: 'Bij Van Bijsteren krijg je een vast dienstverband conform de cao Afbouw. Goede materialen en een werkgever die zijn afspraken nakomt.' },
];

const stappen = [
  { nummer: 1, titel: 'Solliciteer of bel', beschrijving: `Stuur je cv of een korte motivatie via het formulier. Of bel gewoon: ${bedrijf.telefoonDisplay}. Wij houden het laagdrempelig.` },
  { nummer: 2, titel: 'Eerste contact (binnen 2 werkdagen)', beschrijving: 'Je hoort snel van ons — altijd binnen 2 werkdagen. We bespreken telefonisch kort je achtergrond en je verwachtingen.' },
  { nummer: 3, titel: 'Kennismakingsgesprek', beschrijving: 'We nodigen je uit voor een gesprek. Informeel en eerlijk. Wij vertellen wat wij zoeken, jij vertelt wie je bent.' },
  { nummer: 4, titel: 'Meelopen (optioneel)', beschrijving: 'Wil je eerst een dag meekijken hoe het er bij ons aan toe gaat? Dat kan. Beter goed kennismaken dan teleurstellingen achteraf.' },
  { nummer: 5, titel: 'Aanbod', beschrijving: 'Als het klikt, doen we je een eerlijk aanbod. Gewoon een gesprek, geen druk.' },
];
---

<BaseLayout
  title="Werken bij Van Bijsteren Stukadoorsbedrijf Harderwijk | Vacatures stukadoor"
  description="Werken als stukadoor bij Van Bijsteren in Harderwijk? Een hecht familiebedrijf, vast contract, cao Afbouw en werk dichtbij huis. Bekijk onze vacatures."
>
  <HeroSection
    variant="recruitment"
    badge={`${vacatures.length > 0 ? 'Vacatures open' : 'Wij zoeken vakmensen'}`}
    heading="Werken bij Van Bijsteren — waar vakmanschap telt"
    subheading="Een hecht familiebedrijf in Harderwijk, dicht bij huis, aan mooi en afwisselend werk. Met nette voorwaarden en ruimte om je te ontwikkelen."
    primaryCta={{ label: 'Bekijk vacatures', href: '#vacatures' }}
    secondaryCta={{ label: 'Open sollicitatie', href: '/werken-bij/open-sollicitatie' }}
    image={{ src: stukadoorAanHetWerk, alt: 'Van Bijsteren stukadoor aan het werk', width: 1600, height: 1200 }}
  />

  <!-- Waarom Van Bijsteren -->
  <section class="container py-12 sm:py-20 lg:py-24">
    <div class="max-w-content">
      <span class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-primary-dark">
        <span class="h-px w-8 bg-primary-dark"></span>
        Waarom hier
      </span>
      <h2 class="mt-3 text-ink tracking-tight">Waarom Van Bijsteren?</h2>
    </div>
    <div class="mt-8 grid gap-4 sm:mt-12 sm:gap-6 sm:grid-cols-2 lg:gap-7">
      {redenen.map((r) => (
        <article
          class="group relative flex flex-col overflow-hidden rounded-2xl border border-border-light bg-surface p-5 sm:p-7 lg:p-8
                 transition-[transform,box-shadow,border-color] duration-300
                 hover:-translate-y-1 hover:shadow-lg hover:border-primary/25"
        >
          <span aria-hidden="true"
                class="pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-br from-primary-10 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></span>
          <span class="relative inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary-10 text-primary-dark ring-1 ring-primary/10
                       transition-[background-color,color,transform] duration-300
                       group-hover:bg-primary group-hover:text-white group-hover:scale-105">
            <Icon name={r.icon} size={26} />
          </span>
          <h3 class="relative mt-4 text-lg! font-semibold text-ink tracking-tight sm:mt-5 sm:text-xl!">{r.titel}</h3>
          <p class="relative mt-2 text-sm leading-relaxed text-ink-light sm:mt-2.5 sm:text-base">{r.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Hoe ziet een werkdag eruit — split met foto -->
  <section class="border-y border-border-light bg-surface-soft py-12 sm:py-20 lg:py-24">
    <div class="container grid items-center gap-8 sm:gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
      <div class="max-w-prose">
        <span class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-primary-dark">
          <span class="h-px w-8 bg-primary-dark"></span>
          Een dag bij ons
        </span>
        <h2 class="mt-3 text-ink tracking-tight">Hoe ziet een werkdag eruit?</h2>
        <div class="prose-body mt-6 flex flex-col gap-4 text-lg leading-relaxed text-ink-light">
          <p>Je rijdt 's ochtends naar de klus in de regio. We werken altijd met goed
          materiaal en degelijk gereedschap. Tijdens de uitvoering ben je verantwoordelijk
          voor jouw deel van het werk, maar er is altijd een ervaren collega beschikbaar
          voor overleg of begeleiding.</p>
          <p>Eind van de dag lever je netjes op en rij je naar huis — in de regio, niet
          twee uur verderop.</p>
        </div>
      </div>
      <div class="relative">
        <div class="pointer-events-none absolute -bottom-5 -right-5 h-full w-full rounded-2xl bg-primary/15 lg:-bottom-7 lg:-right-7" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -top-4 -left-4 h-20 w-20 rounded-2xl border-2 border-primary/30" aria-hidden="true"></div>
        <Image
          src={stucwerkInUitvoering}
          alt="Stucwerk in uitvoering — kleurrijke onderlaag klaar voor afwerking"
          widths={[400, 600, 800, 1000, 1200]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          formats={['webp']}
          quality={78}
          loading="lazy"
          class="relative aspect-[4/3] w-full rounded-2xl object-cover shadow-xl ring-1 ring-black/5"
        />
      </div>
    </div>
  </section>

  <!-- Openstaande vacatures -->
  <section id="vacatures" class="container py-12 sm:py-20 lg:py-24">
    <div class="max-w-content">
      <span class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-primary-dark">
        <span class="h-px w-8 bg-primary-dark"></span>
        Vacatures
      </span>
      <h2 class="mt-3 text-ink tracking-tight">Openstaande vacatures</h2>
    </div>
    <div class="mt-8 grid gap-4 sm:mt-12 sm:gap-6 sm:grid-cols-2">
      {vacatures.map((vac) => (
        <article
          class="group relative flex flex-col rounded-2xl border border-border-light bg-surface p-5 shadow-sm sm:p-7
                 transition-[transform,box-shadow,border-color] duration-300
                 hover:-translate-y-1 hover:shadow-lg hover:border-primary/30"
        >
          <div class="flex items-start justify-between gap-4">
            <h3 class="text-lg! font-semibold text-ink tracking-tight sm:text-xl!">{vac.data.titel}</h3>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-primary-dark ring-1 ring-primary/20">
              <span class="h-1.5 w-1.5 rounded-full bg-primary animate-pulse"></span>
              Open
            </span>
          </div>
          <p class="mt-3 text-base leading-relaxed text-ink-light">{vac.data.samenvatting}</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {vac.data.highlights.map((h) => (
              <li class="rounded-full bg-primary-10 px-3 py-1 text-sm font-medium text-primary-dark ring-1 ring-primary/10">{h}</li>
            ))}
          </ul>
          <a
            href={`/werken-bij/vacature/${vac.data.slug}`}
            class="mt-6 inline-flex items-center gap-1.5 font-semibold text-primary-dark after:absolute after:inset-0 after:content-['']"
          >
            <span class="border-b border-transparent transition-colors group-hover:border-primary-dark">Bekijk vacature</span>
            <ArrowRight size={18} aria-hidden="true" strokeWidth={2.25} class="transition-transform duration-300 group-hover:translate-x-1" />
          </a>
        </article>
      ))}
      <article
        class="group relative flex flex-col rounded-2xl border-2 border-dashed border-primary/25 bg-primary-10/50 p-5 sm:p-7
               transition-[background-color,border-color,transform] duration-300
               hover:-translate-y-1 hover:border-primary hover:bg-primary-10"
      >
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-white text-primary-dark shadow-sm ring-1 ring-primary/15">
          <Sparkles size={22} aria-hidden="true" strokeWidth={2.25} />
        </span>
        <h3 class="mt-4 text-lg! font-semibold text-ink tracking-tight sm:mt-5 sm:text-xl!">Open sollicitatie</h3>
        <p class="mt-2.5 text-base leading-relaxed text-ink-light">Geen passende vacature gevonden? Wij zijn altijd geïnteresseerd in goede stukadoors.</p>
        <a
          href="/werken-bij/open-sollicitatie"
          class="mt-6 inline-flex items-center gap-1.5 font-semibold text-primary-dark after:absolute after:inset-0 after:content-['']"
        >
          <span class="border-b border-transparent transition-colors group-hover:border-primary-dark">Stuur open sollicitatie</span>
          <ArrowRight size={18} aria-hidden="true" strokeWidth={2.25} class="transition-transform duration-300 group-hover:translate-x-1" />
        </a>
      </article>
    </div>
  </section>

  <!-- Werkwijze -->
  <section class="border-t border-border-light bg-surface-soft">
    <div class="container">
      <WerkwijzeSection heading="Zo werkt solliciteren bij Van Bijsteren" steps={stappen} />
    </div>
  </section>

  <CTASection
    heading="Interesse? Neem de eerste stap."
    subheading="Solliciteer direct of kom een keer langs in de showroom."
    primaryCta={{ label: 'Bekijk vacatures', href: '#vacatures' }}
    secondaryCta={{ label: 'Kom langs', href: '/contact' }}
  />
</BaseLayout>
