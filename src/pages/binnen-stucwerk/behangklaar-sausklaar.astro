---
// src/pages/binnen-stucwerk/behangklaar-sausklaar.astro — cluster-spoke (Fase 3) — PAGE_SPECS §spokes
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import BreadcrumbSchema from '@components/schema/BreadcrumbSchema.astro';
import ServiceSchema from '@components/schema/ServiceSchema.astro';
import HeroSection from '@components/sections/HeroSection.astro';
import ContentBlok from '@components/sections/ContentBlok.astro';
import FAQAccordion from '@components/ui/FAQAccordion.astro';
import InterneLinkBlok from '@components/sections/InterneLinkBlok.astro';
import CTASection from '@components/sections/CTASection.astro';
import { bedrijf } from '@data/bedrijf';
import { prijzen } from '@data/prijzen';
import gladpleisterwanden from '@assets/images/resultaten/gladpleisterwanden.png';

const intro = 'Gaat er behang op uw wanden? Dan is behangklaar stucwerk de juiste keuze: vlak en strak genoeg om op te behangen. Van Bijsteren maakt uw wanden behangklaar in Harderwijk en omgeving.';

const body = `
  <p>Behangklaar betekent dat de wand vlak is en geen oneffenheden heeft die door het
  behang heen te zien zijn. De afwerking is net iets minder glad dan sausklaar, en
  dat hoeft ook niet: het behang komt eroverheen.</p>
  <p>Twijfelt u of u later toch wilt schilderen? Kies dan
  <a href="/binnen-stucwerk/gladpleisterwerk">glad stucwerk (sausklaar)</a>. Dan kunt u
  allebei.</p>
  <p>Als prijsindicatie rekenen wij €${prijzen.wandPerM2} per m² voor wanden, exclusief btw, bij
  minimaal ${prijzen.minimumM2} m². De exacte prijs hoort u na een vrijblijvende opname.</p>
`;

const faqItems = [
  {
    vraag: 'Wat is het verschil tussen sausklaar en behangklaar?',
    antwoord: 'Sausklaar (glad) is zo strak dat u direct kunt schilderen. Behangklaar is vlak genoeg voor behang, maar niet zo glad afgewerkt. Zie ook ons artikel "Sausklaar of behangklaar?"',
  },
];

const kruimels = [
  { label: 'Home', href: '/' },
  { label: 'Stucwerk', href: '/stucwerk' },
  { label: 'Behangklaar stucwerk' },
];
---

<BaseLayout
  title="Behangklaar stucwerk Harderwijk | Van Bijsteren"
  description="Wanden behangklaar laten stucen in Harderwijk en omgeving. Vlak en strak, klaar om te behangen. Vraag een vrijblijvende offerte aan."
>
  <BreadcrumbSchema items={kruimels.map((k) => ({ naam: k.label, href: k.href }))} />
  <ServiceSchema naam="Behangklaar stucwerk" serviceType="Stucwerk" description={intro} />

  <div class="container pt-6"><Breadcrumbs items={kruimels} /></div>

  <HeroSection
    variant="service"
    heading="Behangklaar stucwerk, klaar om te behangen"
    subheading={intro}
    primaryCta={{ label: 'Vraag offerte aan', href: '/offerte' }}
    image={{ src: gladpleisterwanden, alt: 'Wanden strak voorbereid voor behang of verf', width: 1200, height: 900 }}
  />

  <ContentBlok body={body} />

  <section class="border-t border-border-light bg-surface-soft">
    <div class="container max-w-prose py-12 lg:py-16">
      <h2 class="mb-5 text-ink">Veelgestelde vragen</h2>
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <InterneLinkBlok
    heading="Lees ook"
    links={[
      { label: 'Al onze diensten', href: '/stucwerk', omschrijving: 'Glad, behangklaar, plafonds en spackspuitwerk.' },
      { label: 'Sausklaar of behangklaar?', href: '/kennis/sausklaar-of-behangklaar', omschrijving: 'Welke afwerking past bij u?' },
      { label: 'Glad stucwerk', href: '/binnen-stucwerk/gladpleisterwerk', omschrijving: 'Klaar voor de schilder.' },
    ]}
  />

  <CTASection
    heading="Wanden laten voorbereiden?"
    subheading="Vraag vrijblijvend een offerte aan of bel ons direct."
    primaryCta={{ label: 'Vraag offerte aan', href: '/offerte' }}
    secondaryCta={{ label: `Bel ${bedrijf.telefoonDisplay}`, href: `tel:${bedrijf.telefoon}`, ariaLabel: `Bel ${bedrijf.telefoonDisplay} - ${bedrijf.naam}` }}
  />
</BaseLayout>
