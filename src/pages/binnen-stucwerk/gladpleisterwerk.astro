---
// src/pages/binnen-stucwerk/gladpleisterwerk.astro — cluster-spoke (Fase 3) — PAGE_SPECS §spokes
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import BreadcrumbSchema from '@components/schema/BreadcrumbSchema.astro';
import ServiceSchema from '@components/schema/ServiceSchema.astro';
import HeroSection from '@components/sections/HeroSection.astro';
import ContentBlok from '@components/sections/ContentBlok.astro';
import FAQAccordion from '@components/ui/FAQAccordion.astro';
import InterneLinkBlok from '@components/sections/InterneLinkBlok.astro';
import CTASection from '@components/sections/CTASection.astro';
import { bedrijf } from '@data/bedrijf';
import gladpleisterwanden from '@assets/images/resultaten/gladpleisterwanden.png';
import { prijzen, prijsFaqAntwoord } from '@data/prijzen';

const intro = 'Glad stucwerk is waar wij om bekend staan: strakke, egale wanden en plafonds die direct klaar zijn voor de schilder. Ook wel sausklaar stucwerk genoemd. Van Bijsteren doet dit al drie generaties in Harderwijk en omgeving.';

const body = `
  <h2>Wanneer kiest u voor glad stucwerk?</h2>
  <ul>
    <li>U wilt uw wanden of plafonds schilderen en het moet strak zijn</li>
    <li>Er zit oud behang, structuurwerk of een oneffen muur onder</li>
    <li>Nieuwbouw of verbouwing: de wanden moeten in één keer goed</li>
  </ul>

  <h2>Hoe wij werken</h2>
  <p>We komen eerst kijken en beoordelen de ondergrond. Waar nodig herstellen we die
  eerst. Daarna zetten we de wanden strak en glad. Na een paar dagen drogen kan de
  schilder aan de slag.</p>

  <h2>Wat kost het?</h2>
  <p>Als prijsindicatie: €${prijzen.wandPerM2} per m² voor wanden en €${prijzen.plafondPerM2} per m² voor
  plafonds, exclusief btw, bij minimaal ${prijzen.minimumM2} m². De exacte prijs hoort u na een
  vrijblijvende opname.</p>
`;

const faqItems = [
  {
    vraag: 'Wat kost glad stucwerk per m²?',
    antwoord: prijsFaqAntwoord,
  },
  {
    vraag: 'Wat is het verschil tussen sausklaar en behangklaar?',
    antwoord: 'Sausklaar (glad) is zo strak dat u direct kunt schilderen. Behangklaar is vlak genoeg voor behang, maar niet zo glad afgewerkt. Gaat u schilderen, kies dan glad stucwerk.',
  },
];

const kruimels = [
  { label: 'Home', href: '/' },
  { label: 'Stucwerk', href: '/stucwerk' },
  { label: 'Glad stucwerk' },
];
---

<BaseLayout
  title="Glad stucwerk (sausklaar) Harderwijk | Van Bijsteren"
  description={`Glad, sausklaar stucwerk in Harderwijk en omgeving. Strakke wanden en plafonds, klaar voor de schilder. Prijsindicatie €${prijzen.wandPerM2}/m². Vraag een vrijblijvende offerte aan.`}
>
  <BreadcrumbSchema items={kruimels.map((k) => ({ naam: k.label, href: k.href }))} />
  <ServiceSchema naam="Glad stucwerk (sausklaar)" serviceType="Gladpleisterwerk" description={intro} />

  <div class="container pt-6"><Breadcrumbs items={kruimels} /></div>

  <HeroSection
    variant="service"
    heading="Glad stucwerk, klaar voor de schilder"
    subheading={intro}
    primaryCta={{ label: 'Vraag offerte aan', href: '/offerte' }}
    image={{ src: gladpleisterwanden, alt: 'Strak gladgepleisterde wanden in een woning', width: 1200, height: 900 }}
  />

  <ContentBlok body={body} />

  <section class="border-t border-border-light bg-surface-soft">
    <div class="container max-w-prose py-12 lg:py-16">
      <h2 class="mb-5 text-ink">Veelgestelde vragen</h2>
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <InterneLinkBlok
    heading="Lees ook"
    links={[
      { label: 'Al onze diensten', href: '/stucwerk', omschrijving: 'Glad, behangklaar, plafonds en spackspuitwerk.' },
      { label: 'Sausklaar of behangklaar?', href: '/kennis/sausklaar-of-behangklaar', omschrijving: 'Welke afwerking past bij u?' },
      { label: 'Wat kost stucwerk?', href: '/kennis/wat-kost-stucwerk', omschrijving: 'Transparante prijsindicatie.' },
    ]}
  />

  <CTASection
    heading="Strakke wanden laten stucen?"
    subheading="Vraag vrijblijvend een offerte aan of bel ons direct."
    primaryCta={{ label: 'Vraag offerte aan', href: '/offerte' }}
    secondaryCta={{ label: `Bel ${bedrijf.telefoonDisplay}`, href: `tel:${bedrijf.telefoon}`, ariaLabel: `Bel ${bedrijf.telefoonDisplay} - ${bedrijf.naam}` }}
  />
</BaseLayout>
