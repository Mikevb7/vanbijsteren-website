---
// src/pages/stucwerk.astro — pillar (Fase 3) — PAGE_SPECS §/stucwerk
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import BreadcrumbSchema from '@components/schema/BreadcrumbSchema.astro';
import ServiceSchema from '@components/schema/ServiceSchema.astro';
import HeroSection from '@components/sections/HeroSection.astro';
import DienstGrid from '@components/sections/DienstGrid.astro';
import SEOContentSection from '@components/sections/SEOContentSection.astro';
import CTASection from '@components/sections/CTASection.astro';
import PrijsIndicatieSection from '@components/sections/PrijsIndicatieSection.astro';
import { pillarDiensten } from '@data/diensten';
import { bedrijf } from '@data/bedrijf';
import totaaloverzichtKamer from '@assets/images/resultaten/totaaloverzicht-kamer.png';

const intro = 'Van Bijsteren is gespecialiseerd in strak binnenstucwerk: glad stucwerk dat klaar is voor de schilder, behangklaar stucwerk en spackspuitwerk. Op wanden en plafonds, in Harderwijk en omgeving. Al drie generaties, NOA-erkend en netjes afgewerkt.';

const seoBody = `
  <p>Wij doen een paar dingen, en die doen we goed. Of het nu gaat om een kamer, een
  complete woning of een nieuwbouwproject: wij zorgen voor wanden en plafonds die strak
  zijn en klaar voor de schilder of behanger.</p>
  <p>Wij werken voor particulieren en aannemers in Harderwijk, Ermelo, Putten,
  Nunspeet, Zeewolde en de rest van de regio, tot ongeveer 40 km rond Harderwijk.</p>
`;

const kruimels = [
  { label: 'Home', href: '/' },
  { label: 'Stucwerk' },
];
---

<BaseLayout
  title="Stucwerk laten doen in Harderwijk? | Van Bijsteren Stukadoorsbedrijf"
  description="Glad stucwerk, behangklaar en spackspuitwerk voor wanden en plafonds in Harderwijk en omgeving. Van Bijsteren, NOA-erkend sinds 1967."
>
  <BreadcrumbSchema items={kruimels.map((k) => ({ naam: k.label, href: k.href }))} />
  <ServiceSchema naam="Stucwerk" serviceType="Stukadoorswerk" description={intro} />

  <div class="container pt-6"><Breadcrumbs items={kruimels} /></div>

  <HeroSection
    variant="service"
    heading="Stucwerk - erkend vakmanschap in de Noord-Veluwe"
    subheading={intro}
    primaryCta={{ label: 'Vraag offerte aan', href: '/offerte' }}
    image={{ src: totaaloverzichtKamer, alt: 'Volledig gestuct en afgewerkte kamer', width: 1200, height: 900 }}
  />

  <DienstGrid heading="Wat wij doen" diensten={pillarDiensten} columns={2} />

  <SEOContentSection heading="Vakwerk voor particulier en aannemer" body={seoBody} />

  <PrijsIndicatieSection />

  <CTASection
    heading="Stucwerk laten uitvoeren?"
    subheading="Vraag vrijblijvend een offerte aan of bel ons direct."
    primaryCta={{ label: 'Vraag offerte aan', href: '/offerte' }}
    secondaryCta={{ label: `Bel ${bedrijf.telefoonDisplay}`, href: `tel:${bedrijf.telefoon}`, ariaLabel: `Bel ${bedrijf.telefoonDisplay} - ${bedrijf.naam}` }}
  />
</BaseLayout>
