---
// src/pages/buitengevelstucwerk/index.astro — pillar (Fase 3) — PAGE_SPECS §diensten
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import BreadcrumbSchema from '@components/schema/BreadcrumbSchema.astro';
import ServiceSchema from '@components/schema/ServiceSchema.astro';
import HeroSection from '@components/sections/HeroSection.astro';
import DienstGrid from '@components/sections/DienstGrid.astro';
import SEOContentSection from '@components/sections/SEOContentSection.astro';
import InterneLinkBlok from '@components/sections/InterneLinkBlok.astro';
import CTASection from '@components/sections/CTASection.astro';
import { spokesVoor } from '@data/diensten';
import { bedrijf } from '@data/bedrijf';
import buitengevelAfgewerkt from '@assets/images/resultaten/buitengevel-afgewerkt.png';

const intro = 'Een mooie, duurzame gevel begint bij goed buitenstucwerk. Van Bijsteren verzorgt buitengevelstucwerk in Harderwijk en omgeving: weersbestendig, onderhoudsvriendelijk en strak afgewerkt.';

const seoBody = `
  <p>Buitengevelstucwerk beschermt uw gevel tegen weer en wind en geeft uw woning of
  bedrijfspand een verzorgde uitstraling. Wij gebruiken materialen die zijn afgestemd
  op buitentoepassing en de Nederlandse weersomstandigheden.</p>
  <p>Wij adviseren u graag over de juiste afwerking en kleur voor uw gevel.</p>
`;

const kruimels = [
  { label: 'Home', href: '/' },
  { label: 'Stucwerk', href: '/stucwerk' },
  { label: 'Buitengevelstucwerk' },
];
---

<BaseLayout
  title="Buitengevelstucwerk Harderwijk | Gevelafwerking | Van Bijsteren"
  description="Duurzaam buitengevelstucwerk in Harderwijk en omgeving. Weersbestendige en mooie afwerking van uw gevel. Vraag vrijblijvend een offerte aan."
>
  <BreadcrumbSchema items={kruimels.map((k) => ({ naam: k.label, href: k.href }))} />
  <ServiceSchema naam="Buitengevelstucwerk" serviceType="Gevelstucwerk" description={intro} />

  <div class="container pt-6"><Breadcrumbs items={kruimels} /></div>

  <HeroSection
    variant="service"
    heading="Buitengevelstucwerk — duurzame gevelafwerking"
    subheading={intro}
    primaryCta={{ label: 'Vraag offerte aan', href: '/offerte' }}
    image={{ src: buitengevelAfgewerkt, alt: 'Afgewerkte buitengevel met stucwerk', width: 1200, height: 900 }}
  />

  <DienstGrid heading="Onze gevelafwerkingen" diensten={spokesVoor('buitengevelstucwerk')} columns={2} />

  <SEOContentSection heading="Bescherming en uitstraling voor uw gevel" body={seoBody} />

  <InterneLinkBlok
    heading="Meer over stucwerk"
    links={[
      { label: 'Stucwerk (overzicht)', href: '/stucwerk', omschrijving: 'Alle vormen van stucwerk.' },
      { label: 'Sierpleister', href: '/sierpleister', omschrijving: 'Decoratieve wandafwerkingen.' },
      { label: 'Reparatie & renovatie', href: '/stucwerk-reparatie-renovatie', omschrijving: 'Herstel van beschadigd stucwerk.' },
    ]}
  />

  <CTASection
    heading="Uw gevel laten stucadoreren?"
    subheading="Vraag vrijblijvend een offerte aan of bel ons direct."
    primaryCta={{ label: 'Vraag offerte aan', href: '/offerte' }}
    secondaryCta={{ label: `Bel ${bedrijf.telefoonDisplay}`, href: `tel:${bedrijf.telefoon}`, ariaLabel: `Bel ${bedrijf.telefoonDisplay} — ${bedrijf.naam}` }}
  />
</BaseLayout>
