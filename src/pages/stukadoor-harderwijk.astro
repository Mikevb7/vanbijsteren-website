---
// src/pages/stukadoor-harderwijk.astro — lokaal hoofd (Fase 3) — PAGE_SPECS §lokaal
// CONTENT-GATE: noindex tot er ≥2 Harderwijk-projecten met foto zijn (PAGE_SPECS: "niet live zonder").
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/sections/HeroSection.astro';
import SEOContentSection from '@components/sections/SEOContentSection.astro';
import DienstGrid from '@components/sections/DienstGrid.astro';
import FAQAccordion from '@components/ui/FAQAccordion.astro';
import RegioLinkBlok from '@components/sections/RegioLinkBlok.astro';
import CTASection from '@components/sections/CTASection.astro';
import { pillarDiensten } from '@data/diensten';
import { regio } from '@data/regio';
import { bedrijf } from '@data/bedrijf';
import pandExterieur from '@assets/images/showroom/pand-exterieur.jpg';

const intro = `
  <p>Op zoek naar een stukadoor in Harderwijk? Van Bijsteren Stukadoorsbedrijf is in
  Harderwijk gevestigd en werkt dagelijks in de hele stad en omgeving. Erkend NOA-lid,
  altijd een vrijblijvende offerte vooraf.</p>
  <p>Als Harderwijks bedrijf kennen wij de regio op onze duimen. Of het nu gaat om
  renovaties in wijken als Stadsweiden en Drielanden, stucwerk in nieuwbouwprojecten of
  decoratieve afwerkingen in de binnenstad — wij werken er dagelijks. Onze showroom
  vindt u op ${bedrijf.showroom.omschrijving}, waar u verschillende stucafwerkingen
  live kunt bekijken.</p>
`;

const faqItems = [
  {
    vraag: 'Wat kost stucwerk per m²?',
    antwoord: 'De prijs van stucwerk hangt af van de ondergrond, de gewenste afwerking en de oppervlakte. Voor een nauwkeurige prijs komen wij graag vrijblijvend langs om het werk op te nemen.',
  },
  {
    vraag: 'Werken jullie ook buiten Harderwijk?',
    antwoord: 'Ja. Wij werken in de hele Noord-Veluwe — onder andere in Ermelo, Putten, Nunspeet en Zeewolde. Neem contact op om te overleggen.',
  },
];

const andereplaatsen = regio
  .filter((r) => !r.isHoofdlocatie && r.heeftPagina)
  .map((r) => ({ naam: r.naam, href: r.href }));
---

<BaseLayout
  title="Stukadoor Harderwijk | Van Bijsteren — erkend stukadoorsbedrijf"
  description="Op zoek naar een stukadoor in Harderwijk? Van Bijsteren is gevestigd in Harderwijk en werkt in de hele regio. Vraag een vrijblijvende offerte aan."
  noindex={true}
>
  <HeroSection
    variant="local"
    heading="Stukadoor in Harderwijk — Van Bijsteren"
    subheading="Gevestigd in Harderwijk, dagelijks aan het werk in de hele regio. Erkend NOA-stukadoorsbedrijf."
    badge="Gevestigd in Harderwijk"
    primaryCta={{ label: 'Vraag offerte aan', href: '/offerte' }}
    secondaryCta={{ label: `Bel ${bedrijf.telefoonDisplay}`, href: `tel:${bedrijf.telefoon}`, ariaLabel: `Bel ${bedrijf.telefoonDisplay} — ${bedrijf.naam}` }}
    image={{ src: pandExterieur, alt: 'Pand en showroom Van Bijsteren Stukadoorsbedrijf in Harderwijk', width: 1600, height: 1200 }}
  />

  <SEOContentSection heading="Uw stukadoor in Harderwijk" body={intro} />

  <DienstGrid heading="Onze diensten in Harderwijk" diensten={pillarDiensten} columns={3} />

  <section class="container py-12 lg:py-16">
    <div class="max-w-prose">
      <h2 class="mb-5 text-ink">Veelgestelde vragen</h2>
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <RegioLinkBlok heading="Ook werkzaam in" places={andereplaatsen} />

  <CTASection
    heading="Stukwerk nodig in Harderwijk?"
    subheading="Vraag vrijblijvend een offerte aan of bel ons direct."
    primaryCta={{ label: 'Vraag offerte aan', href: '/offerte' }}
    secondaryCta={{ label: `Bel ${bedrijf.telefoonDisplay}`, href: `tel:${bedrijf.telefoon}`, ariaLabel: `Bel ${bedrijf.telefoonDisplay} — ${bedrijf.naam}` }}
  />
</BaseLayout>
