---
// src/pages/kennis/sausklaar-of-behangklaar.astro — kennisartikel (Fase 3) — PAGE_SPECS §kennis
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import BreadcrumbSchema from '@components/schema/BreadcrumbSchema.astro';
import ArticleSchema from '@components/schema/ArticleSchema.astro';
import FAQPageSchema from '@components/schema/FAQPageSchema.astro';
import HeroSection from '@components/sections/HeroSection.astro';
import ContentBlok from '@components/sections/ContentBlok.astro';
import FAQAccordion from '@components/ui/FAQAccordion.astro';
import InterneLinkBlok from '@components/sections/InterneLinkBlok.astro';
import CTASection from '@components/sections/CTASection.astro';
import ArticleMeta from '@components/ui/ArticleMeta.astro';
import { Lightbulb } from 'lucide-astro';
import { bedrijf } from '@data/bedrijf';

const gepubliceerd = '2026-06-01';

const intro = 'Sausklaar of behangklaar — wat is het verschil? Sausklaar betekent dat de wand egaal genoeg is om direct te schilderen. Behangklaar is een iets ruwere afwerking die de ondergrond voorbereidt op behang. Welke u nodig heeft, hangt af van hoe u de wand wilt afwerken.';

const body = `
  <h2>Wat betekent sausklaar?</h2>
  <p>Sausklaar (ook wel schilderklaar) betekent dat de wand zo strak en egaal is
  afgewerkt dat de schilder er direct verf (sausverf) op kan aanbrengen. Deze
  afwerking is gladder en vraagt iets meer voorbereiding.</p>

  <h2>Wat betekent behangklaar?</h2>
  <p>Behangklaar is een iets ruwere afwerking. De wand is vlak en strak, maar bewust
  niet volledig glad gemaakt, zodat behang goed hecht. Voor behang is een perfect
  gladde ondergrond namelijk niet nodig.</p>

  <h2>Welke kiest u?</h2>
  <p>De keuze hangt af van uw vervolgstap:</p>
  <ul>
    <li>Wilt u de wand <strong>schilderen of sausen</strong>? Kies sausklaar.</li>
    <li>Wilt u de wand <strong>behangen</strong>? Kies behangklaar.</li>
  </ul>
  <p>Twijfelt u nog? Wij adviseren u graag op basis van uw wensen en de staat van
  uw wanden.</p>
`;

const faqItems = [
  {
    vraag: 'Wat is het verschil tussen sausklaar en behangklaar?',
    antwoord: 'Sausklaar betekent dat de wand egaal genoeg is voor schilderwerk. Behangklaar is een iets ruwere afwerking die de ondergrond voor behang voorbereidt.',
  },
  {
    vraag: 'Kan ik op een behangklare wand ook schilderen?',
    antwoord: 'Een behangklare wand is bedoeld als ondergrond voor behang en is iets ruwer dan een sausklare wand. Wilt u schilderen, dan adviseren wij een sausklare afwerking voor het beste resultaat. Vraag ons gerust om advies.',
  },
];

const kruimels = [
  { label: 'Home', href: '/' },
  { label: 'Kennis' },
  { label: 'Sausklaar of behangklaar?' },
];
---

<BaseLayout
  title="Sausklaar of behangklaar? Het verschil uitgelegd | Van Bijsteren"
  description="Sausklaar of behangklaar stucwerk: wat is het verschil en wat heeft u nodig? Van Bijsteren legt het helder uit zodat u de juiste keuze maakt."
>
  <BreadcrumbSchema items={kruimels.map((k) => ({ naam: k.label, href: k.href }))} />
  <ArticleSchema headline="Sausklaar of behangklaar? Het verschil uitgelegd" datePublished={gepubliceerd} url="/kennis/sausklaar-of-behangklaar" aboutNaam="Binnen stucwerk" />
  <FAQPageSchema items={faqItems} />

  <div class="container pt-6"><Breadcrumbs items={kruimels} /></div>

  <HeroSection
    variant="simple"
    badge="Kennisartikel"
    heading="Sausklaar of behangklaar? Het verschil uitgelegd"
    subheading={intro}
    primaryCta={{ label: 'Vraag offerte aan', href: '/offerte' }}
    secondaryCta={{ label: 'Binnen stucwerk', href: '/binnen-stucwerk' }}
  />

  <div class="container max-w-prose pt-6">
    <ArticleMeta datum={gepubliceerd} leestijd={3} auteur={bedrijf.naamKort} />
  </div>

  <div class="container max-w-prose pt-10">
    <aside class="flex gap-4 rounded-2xl border-l-4 border-primary bg-primary-10 p-6 ring-1 ring-primary/10">
      <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary text-white">
        <Lightbulb size={20} aria-hidden="true" strokeWidth={2.25} />
      </span>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-primary-dark">Kern</p>
        <p class="mt-1 text-base leading-relaxed text-ink">
          Kies <strong>sausklaar</strong> als u wilt schilderen, <strong>behangklaar</strong>
          als u wilt behangen. Twijfelt u? Wij adviseren u graag.
        </p>
      </div>
    </aside>
  </div>

  <ContentBlok body={body} />

  <section class="border-y border-border-light bg-surface-soft">
    <div class="container max-w-prose py-10 sm:py-16 lg:py-20">
      <span class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-primary-dark">
        <span class="h-px w-8 bg-primary-dark"></span>
        FAQ
      </span>
      <h2 class="mt-3 mb-8 text-ink tracking-tight">Veelgestelde vragen</h2>
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <InterneLinkBlok
    heading="Lees ook"
    links={[
      { label: 'Behang- en sausklaar', href: '/binnen-stucwerk/behangklaar-sausklaar', omschrijving: 'Onze afwerking voor verf of behang.' },
      { label: 'Gladpleisterwerk', href: '/binnen-stucwerk/gladpleisterwerk', omschrijving: 'Strakke, gladde wanden.' },
      { label: 'Wat kost stucwerk?', href: '/kennis/wat-kost-stucwerk', omschrijving: 'Transparante prijsindicatie.' },
    ]}
  />

  <CTASection
    heading="Wanden laten voorbereiden?"
    subheading="Vraag vrijblijvend een offerte aan of bel ons direct."
    primaryCta={{ label: 'Vraag offerte aan', href: '/offerte' }}
    secondaryCta={{ label: `Bel ${bedrijf.telefoonDisplay}`, href: `tel:${bedrijf.telefoon}`, ariaLabel: `Bel ${bedrijf.telefoonDisplay} — ${bedrijf.naam}` }}
  />
</BaseLayout>
