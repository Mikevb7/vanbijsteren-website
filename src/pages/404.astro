---
// src/pages/404.astro (redesigned v2)
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import { Compass } from 'lucide-astro';
---

<BaseLayout
  title="Pagina niet gevonden (404) | Van Bijsteren Stukadoors"
  description="Deze pagina bestaat niet of is verplaatst. Ga terug naar de homepage of neem contact met ons op."
  noindex={true}
>
  <section class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute -top-32 -right-32 -z-10 h-96 w-96 rounded-full bg-primary-10 blur-3xl opacity-60" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-40 -z-10 h-96 w-96 rounded-full bg-primary-10 blur-3xl opacity-40" aria-hidden="true"></div>

    <div class="container relative py-24 text-center max-w-content lg:py-32">
      <div class="mx-auto inline-flex h-20 w-20 items-center justify-center rounded-2xl bg-primary-10 text-primary-dark ring-1 ring-primary/15">
        <Compass size={38} aria-hidden="true" strokeWidth={1.75} />
      </div>

      <p class="mt-6 text-6xl font-extrabold tracking-tight text-primary-dark lg:text-7xl">404</p>
      <h1 class="mt-4 tracking-tight">Pagina niet gevonden</h1>
      <p class="mx-auto mt-5 max-w-prose text-lg leading-relaxed text-ink-light">
        De pagina die u zoekt bestaat niet of is verplaatst. Controleer de link of ga terug naar de homepage.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href="/" size="lg">Naar de homepage</Button>
        <Button href="/stucwerk" variant="secondary" size="lg">Bekijk onze diensten</Button>
        <Button href="/contact" variant="ghost" size="lg">Contact opnemen</Button>
      </div>
    </div>
  </section>
</BaseLayout>
