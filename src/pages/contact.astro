---
// src/pages/contact.astro — contact (Fase 3, redesign v2) — PAGE_SPECS §/contact
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import HeroSection from '@components/sections/HeroSection.astro';
import FormComponent from '@components/ui/FormComponent.astro';
import LocalBusinessInfoBlock from '@components/ui/LocalBusinessInfoBlock.astro';
import WhatsAppButton from '@components/ui/WhatsAppButton.astro';
import Button from '@components/ui/Button.astro';
import { Store, Phone } from 'lucide-astro';
import { bedrijf } from '@data/bedrijf';
import pandExterieur from '@assets/images/showroom/pand-exterieur.jpg';
---

<BaseLayout
  title="Contact | Van Bijsteren Stukadoorsbedrijf Harderwijk"
  description="Neem contact op met Van Bijsteren Stukadoorsbedrijf in Harderwijk. Bel, WhatsApp of bezoek onze showroom."
>
  <HeroSection
    variant="simple"
    badge="Reactie binnen 1 werkdag"
    heading="Neem contact op"
    subheading="Bel, WhatsApp of vul het formulier in. Wij reageren snel — meestal binnen één werkdag."
    primaryCta={{ label: 'Vraag offerte aan', href: '/offerte' }}
    secondaryCta={{
      label: `Bel ${bedrijf.telefoonDisplay}`,
      href: `tel:${bedrijf.telefoon}`,
      ariaLabel: `Bel ${bedrijf.telefoonDisplay} — ${bedrijf.naam}`,
    }}
  />

  <section class="container py-10 sm:py-16 lg:py-20">
    <div class="grid gap-6 sm:gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-14">
      <!-- Formulier -->
      <div class="rounded-2xl border border-border-light bg-surface p-5 shadow-sm sm:p-7 lg:p-10">
        <span class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-primary-dark">
          <span class="h-px w-8 bg-primary-dark"></span>
          Stuur een bericht
        </span>
        <h2 class="mt-3 text-ink tracking-tight">Stel uw vraag</h2>
        <p class="mt-2 text-ink-light">Laat uw gegevens achter en omschrijf kort uw vraag. Wij nemen contact met u op.</p>
        <div class="mt-8">
          <FormComponent variant="contact" />
        </div>
      </div>

      <!-- Directe acties + NAP -->
      <aside class="flex flex-col gap-6">
        <div class="rounded-2xl bg-gradient-to-br from-primary-10 via-surface-soft to-primary-10 p-7 ring-1 ring-primary/15 lg:p-8">
          <h3 class="text-xl font-semibold text-ink tracking-tight">Liever direct contact?</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-light">
            Bel of stuur een WhatsApp — u krijgt altijd een persoon aan de lijn.
          </p>
          <div class="mt-6 flex flex-col gap-3">
            <Button
              href={`tel:${bedrijf.telefoon}`}
              size="lg"
              variant="primary"
              ariaLabel={`Bel ${bedrijf.telefoonDisplay} — ${bedrijf.naamKort}`}
              class="w-full justify-center"
            >
              <Phone size={18} aria-hidden="true" />Bel {bedrijf.telefoonDisplay}
            </Button>
            <WhatsAppButton
              phoneNumber={bedrijf.telefoon}
              position="inline"
              message="Hallo, ik heb een vraag over stukadoorswerk."
            />
          </div>
        </div>

        <LocalBusinessInfoBlock heading="Onze gegevens" />
      </aside>
    </div>
  </section>

  <!-- Showroom -->
  <section class="border-t border-border-light bg-surface-soft py-12 sm:py-20 lg:py-24" aria-label="Onze showroom">
    <div class="container grid items-center gap-8 sm:gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="relative">
        <div class="pointer-events-none absolute -bottom-5 -right-5 h-full w-full rounded-2xl bg-primary/15 lg:-bottom-7 lg:-right-7" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -top-4 -left-4 h-20 w-20 rounded-2xl border-2 border-primary/30" aria-hidden="true"></div>
        <Image
          src={pandExterieur}
          alt="Pand van Van Bijsteren Stukadoorsbedrijf in Harderwijk"
          widths={[400, 600, 800, 1000, 1200]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          formats={['webp']}
          quality={78}
          loading="lazy"
          class="relative aspect-[4/3] w-full rounded-2xl object-cover shadow-xl ring-1 ring-black/5"
        />
      </div>
      <div>
        <span class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-primary-dark">
          <span class="h-px w-8 bg-primary-dark"></span>
          Bezoek ons
        </span>
        <h2 class="mt-3 flex items-center gap-3 text-ink tracking-tight">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-primary text-white shadow-md">
            <Store size={22} aria-hidden="true" />
          </span>
          Kom langs in onze showroom
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-light">
          In {bedrijf.showroom.naam} op {bedrijf.showroom.omschrijving} kunt u
          verschillende stucafwerkingen live bekijken. Zo maakt u eenvoudig een keuze.
          Loop gerust binnen of bel even vooraf op
          <a href={`tel:${bedrijf.telefoon}`} class="font-semibold text-primary-dark hover:underline">{bedrijf.telefoonDisplay}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
