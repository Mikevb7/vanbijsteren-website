---
// src/components/layout/StickyMobileCTA.astro
// Vaste actiebalk op mobiel; verborgen op desktop (>= lg).
import { bedrijf } from '@data/bedrijf';
import { Phone, FileText } from 'lucide-astro';
---

<div class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-surface border-t border-border-light shadow-lg pb-[env(safe-area-inset-bottom)]">
  <div class="grid grid-cols-2 gap-2 p-2">
    <a
      href={`tel:${bedrijf.telefoon}`}
      class="inline-flex items-center justify-center gap-2 min-h-[44px] rounded-md border-2 border-primary text-primary-dark font-semibold"
    >
      <Phone size={18} aria-hidden="true" />
      Bellen
    </a>
    <a
      href="/offerte"
      class="inline-flex items-center justify-center gap-2 min-h-[44px] rounded-md bg-primary text-white font-semibold hover:bg-primary-dark transition-colors"
    >
      <FileText size={18} aria-hidden="true" />
      Offerte
    </a>
  </div>
</div>
