---
// src/components/layout/Footer.astro (redesigned v2)
import { bedrijf } from '@data/bedrijf';
import { footerNav } from '@data/nav';
import { Phone, MapPin, Mail } from 'lucide-astro';

const jaar = new Date().getFullYear();

const kolommen = [
  { titel: 'Diensten',   items: footerNav.diensten },
  { titel: 'Werkgebied', items: footerNav.werkgebied },
  { titel: 'Bedrijf',    items: footerNav.bedrijf },
  { titel: 'Werken bij', items: footerNav.werkenBij },
];
---

<footer class="relative isolate mt-24 overflow-hidden bg-ink text-surface">
  {/* Subtiele decoratieve accents */}
  <div class="pointer-events-none absolute -top-32 -right-32 h-96 w-96 rounded-full bg-primary/15 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-40 -left-40 h-96 w-96 rounded-full bg-primary/10 blur-3xl" aria-hidden="true"></div>
  {/* Bovenrand accent-lijn */}
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/40 to-transparent" aria-hidden="true"></div>

  <div class="container relative py-20">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-10 lg:gap-8">
      <!-- Merk + NAP -->
      <div class="col-span-2 md:col-span-3 lg:col-span-2">
        <p class="text-2xl font-extrabold tracking-tight text-white">{bedrijf.naamKort}</p>
        <p class="mt-2 text-sm text-surface/60">Erkend NOA stukadoorsbedrijf in de Noord-Veluwe</p>

        <address class="not-italic mt-6 space-y-3 text-sm text-surface/75">
          <p class="flex items-start gap-3">
            <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/5 ring-1 ring-white/10">
              <MapPin size={15} aria-hidden="true" />
            </span>
            <span class="leading-relaxed">
              {bedrijf.adres.straat}<br />{bedrijf.adres.postcode} {bedrijf.adres.stad}
            </span>
          </p>
          <p>
            <a href={`tel:${bedrijf.telefoon}`} class="group inline-flex items-center gap-3 transition-colors hover:text-white">
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/5 ring-1 ring-white/10 transition-colors group-hover:bg-primary group-hover:ring-primary">
                <Phone size={15} aria-hidden="true" />
              </span>
              {bedrijf.telefoonDisplay}
            </a>
          </p>
          <p>
            <a href={`mailto:${bedrijf.email}`} class="group inline-flex items-center gap-3 transition-colors hover:text-white">
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/5 ring-1 ring-white/10 transition-colors group-hover:bg-primary group-hover:ring-primary">
                <Mail size={15} aria-hidden="true" />
              </span>
              {bedrijf.email}
            </a>
          </p>
        </address>
      </div>

      <!-- Link-kolommen -->
      {kolommen.map((kolom) => (
        <nav aria-label={kolom.titel}>
          <p class="mb-4 text-xs font-semibold uppercase tracking-wider text-white/50">{kolom.titel}</p>
          <ul class="space-y-2.5">
            {kolom.items.map((item) => (
              <li>
                <a href={item.href} class="inline-block text-sm text-surface/75 transition-colors hover:text-white hover:translate-x-0.5">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>

  <!-- Onderbalk -->
  <div class="relative border-t border-white/10">
    <div class="container flex flex-col items-center justify-between gap-4 py-6 sm:flex-row">
      <p class="text-sm text-surface/60">
        &copy; {jaar} {bedrijf.naam}. Alle rechten voorbehouden.
      </p>
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {footerNav.juridisch.map((item) => (
          <li>
            <a href={item.href} class="text-sm text-surface/60 transition-colors hover:text-white hover:underline">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
