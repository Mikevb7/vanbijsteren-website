---
// src/components/cards/TestimonialCard.astro — COMPONENT_SPEC §10 (redesigned v4)
// Ondersteunt zowel lokale reviews als Google Places API reviews.
// Google-reviews: auteurUrl + profielFoto worden zichtbaar getoond (Google's
// attributieregels vereisen zichtbare bron-link + auteur naam).
// GEEN AggregateRating-schema op deze card (SEO_STRATEGY §6.9).
import { Star, Quote } from 'lucide-astro';
import type { ReviewProps } from '@/types';

type Props = ReviewProps & { class?: string };

const {
  quote, auteur, plaats, rating, bron, datum,
  auteurUrl, profielFoto, tijdRelatief,
  class: extra = '',
} = Astro.props;

const heel = Math.round(Math.max(0, Math.min(5, rating)));
// Voor Google-reviews toont de relative time ("3 maanden geleden"), voor lokale reviews het jaar
const tijdLabel = tijdRelatief ?? datum;
const meta = [plaats, tijdLabel].filter(Boolean).join(' · ');
const isGoogle = (bron ?? '').toLowerCase() === 'google';
---

<figure
  class:list={[
    'group relative flex h-full flex-col gap-5 overflow-hidden rounded-2xl border border-border-light bg-surface p-7 shadow-sm',
    'transition-[transform,box-shadow,border-color] duration-300',
    'hover:-translate-y-1 hover:shadow-lg hover:border-primary/25',
    extra,
  ]}
>
  {/* Decoratief quote-mark op de achtergrond */}
  <Quote
    size={110}
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-6 -right-4 text-primary/[0.06]"
    fill="currentColor"
  />

  <div class="relative flex items-center justify-between gap-3">
    <div class="flex items-center gap-0.5 text-warning" role="img" aria-label={`${heel} van 5 sterren`}>
      {Array.from({ length: 5 }).map((_, i) => (
        <Star size={18} aria-hidden="true" fill={i < heel ? 'currentColor' : 'none'} strokeWidth={2} />
      ))}
    </div>
    {bron && (
      <span class="inline-flex items-center gap-1.5 rounded-full bg-surface-soft px-2.5 py-0.5 text-xs font-medium text-ink-muted ring-1 ring-border-light">
        {isGoogle && (
          <svg width="12" height="12" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
        )}
        {isGoogle ? 'Google' : `via ${bron}`}
      </span>
    )}
  </div>

  <blockquote class="relative grow text-base leading-relaxed text-ink">
    <p>&ldquo;{quote}&rdquo;</p>
  </blockquote>

  <figcaption class="relative flex items-center gap-3 border-t border-border-light pt-4 text-sm">
    {profielFoto && (
      <img
        src={profielFoto}
        alt=""
        width={40}
        height={40}
        loading="lazy"
        referrerpolicy="no-referrer"
        class="h-10 w-10 shrink-0 rounded-full ring-1 ring-border-light"
      />
    )}
    <div class="min-w-0 grow">
      {auteurUrl ? (
        <a
          href={auteurUrl}
          rel="noopener nofollow"
          target="_blank"
          class="font-semibold text-ink transition-colors hover:text-primary-dark hover:underline"
        >{auteur}</a>
      ) : (
        <span class="block font-semibold text-ink">{auteur}</span>
      )}
      {meta && <span class="mt-0.5 block text-ink-muted">{meta}</span>}
    </div>
  </figcaption>
</figure>
