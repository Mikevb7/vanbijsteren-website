---
// src/components/sections/SEOContentSection.astro — COMPONENT_SPEC §18 (redesigned v2)
import FAQAccordion from '@components/ui/FAQAccordion.astro';
import type { FAQItem } from '@/types';

type Props = {
  heading: string;
  body: string;
  headingLevel?: 'h2' | 'h3';
  faqItems?: FAQItem[];
  class?: string;
};

const { heading, body, headingLevel = 'h2', faqItems = [], class: extra = '' } = Astro.props;
const Heading = headingLevel;
---

<section class:list={['border-y border-border-light bg-surface-soft', extra]}>
  <div class="container max-w-prose py-10 sm:py-16 lg:py-20">
    <span class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-primary-dark">
      <span class="h-px w-8 bg-primary-dark"></span>
      Verdieping
    </span>
    <Heading class="mt-3 text-ink tracking-tight">{heading}</Heading>
    <div class="prose-body mt-6 flex flex-col gap-5 text-base leading-relaxed text-ink-light" set:html={body} />

    {faqItems.length > 0 && (
      <div class="mt-12">
        <h3 class="mb-5 text-ink tracking-tight">Veelgestelde vragen</h3>
        <FAQAccordion items={faqItems} />
      </div>
    )}
  </div>
</section>
