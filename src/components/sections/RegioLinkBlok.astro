---
// src/components/sections/RegioLinkBlok.astro — COMPONENT_SPEC §11 (redesigned v2)
import { MapPin, ArrowUpRight } from 'lucide-astro';

interface Plaats {
  naam:    string;
  href?:   string;
  actief?: boolean;
}

type Props = {
  heading: string;
  intro?: string;
  places: Plaats[];
  mapEmbed?: string;
  class?: string;
};

const { heading, intro, places, mapEmbed, class: extra = '' } = Astro.props;
---

<section class:list={['container py-12 sm:py-20 lg:py-24', extra]}>
  <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
    <div>
      <span class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-primary-dark">
        <span class="h-px w-8 bg-primary-dark"></span>
        Werkgebied
      </span>
      <h2 class="mt-3 text-ink tracking-tight">{heading}</h2>
      {intro && <p class="mt-5 text-lg leading-relaxed text-ink-light">{intro}</p>}

      <ul class="mt-8 flex flex-wrap gap-2.5">
        {places.map((plaats) => (
          <li>
            {plaats.href ? (
              <a
                href={plaats.href}
                class:list={[
                  'group inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-semibold',
                  'transition-[background-color,color,transform,box-shadow] duration-200',
                  plaats.actief
                    ? 'bg-primary text-white shadow-md ring-1 ring-primary/40 hover:bg-primary-dark hover:-translate-y-0.5'
                    : 'bg-primary-10 text-primary-dark ring-1 ring-primary/15 hover:bg-primary hover:text-white hover:-translate-y-0.5 hover:shadow-md',
                ]}
              >
                <MapPin size={14} aria-hidden="true" strokeWidth={2.5} />
                {plaats.naam}
                <ArrowUpRight
                  size={14}
                  aria-hidden="true"
                  strokeWidth={2.5}
                  class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
              </a>
            ) : (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-surface-soft px-4 py-2 text-sm font-medium text-ink-muted ring-1 ring-border-light">
                <MapPin size={14} aria-hidden="true" />
                {plaats.naam}
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>

    {mapEmbed && (
      <div class="overflow-hidden rounded-2xl border border-border-light shadow-lg ring-1 ring-black/5" set:html={mapEmbed} />
    )}
  </div>
</section>
