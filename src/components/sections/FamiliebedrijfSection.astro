---
// src/components/sections/FamiliebedrijfSection.astro — COMPONENT_SPEC §14 (redesigned v2 + perf)
import { Image } from 'astro:assets';
import Icon from '@components/ui/Icon.astro';
import type { Afbeelding } from '@/types';

interface Kernwaarde {
  icon: string;
  titel: string;
  tekst?: string;
}

type Props = {
  heading: string;
  body: string;        // HTML
  image?: Afbeelding;
  highlights?: Kernwaarde[];
  imageLeft?: boolean;
  class?: string;
};

const {
  heading, body, image, highlights = [], imageLeft = false, class: extra = '',
} = Astro.props;

const heeftMetadata = image && typeof image.src !== 'string';
const stringSrc     = image && typeof image.src === 'string' ? image.src : '';
---

<section class:list={['container py-10 sm:py-20 lg:py-28', extra]}>
  <div class="grid items-center gap-8 sm:gap-14 lg:grid-cols-2 lg:gap-16">
    {image && (
      <div class:list={['relative', imageLeft ? 'lg:order-1' : 'lg:order-2']}>
        {/* Offset decoratief frame achter foto */}
        <div class="pointer-events-none absolute -bottom-5 -right-5 h-full w-full rounded-2xl bg-primary/15 lg:-bottom-7 lg:-right-7" aria-hidden="true"></div>
        {/* Klein accent-vierkant links-boven */}
        <div class="pointer-events-none absolute -top-4 -left-4 h-20 w-20 rounded-2xl border-2 border-primary/30" aria-hidden="true"></div>

        {heeftMetadata ? (
          <Image
            src={image.src as ImageMetadata}
            alt={image.alt}
            widths={[400, 600, 800, 1000, 1200]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            formats={['webp']}
            quality={78}
            loading="lazy"
            class="relative aspect-[4/3] w-full rounded-2xl object-cover shadow-xl ring-1 ring-black/5"
          />
        ) : (
          <img
            src={stringSrc}
            alt={image.alt}
            width={image.width}
            height={image.height}
            loading="lazy"
            class="relative aspect-[4/3] w-full rounded-2xl object-cover shadow-xl ring-1 ring-black/5"
          />
        )}
      </div>
    )}

    <div class={imageLeft ? 'lg:order-2' : 'lg:order-1'}>
      {/* Eyebrow label */}
      <span class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-primary-dark">
        <span class="h-px w-8 bg-primary-dark"></span>
        Familiebedrijf
      </span>

      <h2 class="mt-3 text-ink tracking-tight">{heading}</h2>
      <div class="prose-body mt-5 flex flex-col gap-3.5 text-base leading-relaxed text-ink-light sm:mt-6 sm:gap-4 sm:text-lg" set:html={body} />

      {highlights.length > 0 && (
        <ul class="mt-8 grid grid-cols-3 gap-3 sm:mt-10 sm:gap-6">
          {highlights.map((w) => (
            <li class="flex flex-col items-center gap-2 text-center sm:items-start sm:text-left sm:gap-3">
              <span class="inline-flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center rounded-xl bg-primary-10 text-primary-dark ring-1 ring-primary/10 shrink-0">
                <Icon name={w.icon} size={22} />
              </span>
              <span class="text-sm sm:text-base font-semibold text-ink leading-snug">{w.titel}</span>
              {w.tekst && <span class="text-sm leading-relaxed text-ink-light">{w.tekst}</span>}
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>
