---
// src/components/sections/Timeline.astro — COMPONENT_SPEC §15 (redesigned v2)
import type { TijdlijnEvent } from '@/types';

type Props = {
  heading?: string;
  events: TijdlijnEvent[];
  class?: string;
};

const { heading, events, class: extra = '' } = Astro.props;
---

<section class:list={['container py-20 lg:py-24', extra]}>
  {heading && (
    <div class="mb-16 text-center">
      <span class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-primary-dark">
        <span class="h-px w-8 bg-primary-dark"></span>
        Geschiedenis
        <span class="h-px w-8 bg-primary-dark"></span>
      </span>
      <h2 class="mt-3 text-ink tracking-tight">{heading}</h2>
    </div>
  )}

  <ol class="relative mx-auto max-w-3xl">
    {/* Verticale lijn (mobiel links, desktop midden) */}
    <div class="absolute left-2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-primary/30 via-primary/40 to-primary/10 lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></div>

    {events.map((event, i) => {
      const rechts = i % 2 === 1;
      return (
        <li class:list={[
          'relative mb-12 pl-10 last:mb-0 lg:grid lg:grid-cols-2 lg:gap-12 lg:pl-0',
          rechts ? 'lg:text-left' : 'lg:text-right',
        ]}>
          {/* Punt op de lijn */}
          <span
            class="absolute left-0 top-1 inline-flex h-5 w-5 items-center justify-center rounded-full bg-primary shadow-md ring-4 ring-primary-10 lg:left-1/2 lg:-translate-x-1/2"
            aria-hidden="true"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-white"></span>
          </span>

          <div class:list={[
            'rounded-2xl border border-border-light bg-surface p-6 shadow-sm transition-shadow duration-300 hover:shadow-md',
            rechts ? 'lg:col-start-2' : 'lg:col-start-1',
          ]}>
            <p class="text-3xl font-extrabold tracking-tight text-primary-dark lg:text-4xl">{event.jaar}</p>
            <h3 class="mt-2 text-xl font-semibold text-ink tracking-tight">{event.titel}</h3>
            <p class="mt-2 text-base leading-relaxed text-ink-light">{event.beschrijving}</p>
          </div>
        </li>
      );
    })}
  </ol>
</section>
