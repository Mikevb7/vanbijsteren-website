---
// src/components/ui/WhatsAppButton.astro — COMPONENT_SPEC §5
// Pure <a> naar wa.me — geen JS nodig. Pulse respecteert prefers-reduced-motion.
import { MessageCircle } from 'lucide-astro';

type Props = {
  phoneNumber: string;          // internationaal zonder +, bv. "31612345678"
  message?: string;
  label?: string;
  position?: 'floating' | 'inline';
  class?: string;
};

const {
  phoneNumber,
  message = '',
  label = 'Neem contact op via WhatsApp',
  position = 'floating',
  class: extra = '',
} = Astro.props;

const cleanNumber = phoneNumber.replace(/[^0-9]/g, '');
const href = `https://wa.me/${cleanNumber}${message ? `?text=${encodeURIComponent(message)}` : ''}`;
const floating = position === 'floating';
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-full bg-[#25D366] font-semibold text-white shadow-lg transition-transform hover:scale-105',
    floating
      ? 'wa-pulse fixed bottom-20 right-5 z-40 h-14 w-14 lg:bottom-6'
      : 'px-5 py-3',
    extra,
  ]}
>
  <MessageCircle size={floating ? 28 : 22} aria-hidden="true" />
  {!floating && <span>WhatsApp</span>}
</a>

<style>
  @keyframes wa-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5); }
    70%  { box-shadow: 0 0 0 12px rgba(37, 211, 102, 0); }
    100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
  }
  .wa-pulse { animation: wa-pulse 2s ease-out 2; }
  @media (prefers-reduced-motion: reduce) {
    .wa-pulse { animation: none; }
  }
</style>
