# .env.example — copy naar .env en vul waarden in
# .env staat in .gitignore en wordt nooit gecommit.

# ─── Google Places API ────────────────────────────────────────────────────────
# Wordt gebruikt door scripts/fetch-google-reviews.mjs (build-time).
# Setup:
#   1. Ga naar https://console.cloud.google.com/
#   2. Maak of kies een project → APIs & Services → Library
#   3. Enable: "Places API" (klassiek) — dat is genoeg voor Find Place + Place Details
#   4. APIs & Services → Credentials → Create credentials → API key
#   5. RECOMMENDED: Restrict de key onder "Application restrictions" → IP addresses
#      (voeg je build-server IP toe, bijv. Vercel of GitHub Actions),
#      en onder "API restrictions" alleen "Places API" toestaan
#   6. Plak de key hieronder
GOOGLE_MAPS_API_KEY=

# ─── Formspree form IDs (formulieren) ────────────────────────────────────────
# Zie src/components/ui/FormComponent.astro voor gebruik.
PUBLIC_FORMSPREE_OFFERTE=
PUBLIC_FORMSPREE_SOLLICITATIE=
PUBLIC_FORMSPREE_CONTACT=
