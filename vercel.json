{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.google.com; connect-src 'self' https://plausible.io https://formspree.io;"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.php", "destination": "/", "permanent": true },

    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(www\\.)?stukadoorharderwijk\\.nl" }],
      "destination": "https://vanbijsterenstukadoors.nl/stukadoor-harderwijk",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(www\\.)?stucadoorharderwijk\\.nl" }],
      "destination": "https://vanbijsterenstukadoors.nl/stukadoor-harderwijk",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(www\\.)?stukadoorermelo\\.nl" }],
      "destination": "https://vanbijsterenstukadoors.nl/stukadoor-ermelo",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(www\\.)?stukadoornunspeet\\.nl" }],
      "destination": "https://vanbijsterenstukadoors.nl/stukadoor-nunspeet",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(www\\.)?stukadoorzeewolde\\.nl" }],
      "destination": "https://vanbijsterenstukadoors.nl/stukadoor-zeewolde",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(www\\.)?stukadoorhierden\\.nl" }],
      "destination": "https://vanbijsterenstukadoors.nl/werkgebied",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(www\\.)?gladstucen\\.nl" }],
      "destination": "https://vanbijsterenstukadoors.nl/binnen-stucwerk/gladpleisterwerk",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(www\\.)?gladstuken\\.nl" }],
      "destination": "https://vanbijsterenstukadoors.nl/binnen-stucwerk/gladpleisterwerk",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
